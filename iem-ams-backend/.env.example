# IEM Admission Management System - Environment Variables Example
# Copy this file to .env and configure your secrets

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/iem_ams
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=2h
UPLOAD_DIR=uploads

# Email Notification Service (Gmail SMTP App Password)
SMTP_SERVICE=gmail
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_16_digit_app_password
