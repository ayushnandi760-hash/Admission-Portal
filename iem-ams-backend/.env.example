# IEM Admission Management System - Environment Variables Template
# DO NOT commit real secrets or credentials in this file.
# Copy this file to .env and fill in your actual private credentials.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/iem_ams?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=*
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Default Administrator Account (auto-seeded on server startup)
ADMIN_EMAIL=admin@iem.edu.in
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=IEM Administrator

# Option A: HTTPS Email API (Recommended for Render Free Tier - Port 443)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=IEM Admissions <onboarding@resend.dev>

# Option B: Live Gmail SMTP (Works locally or on paid server instances)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="IEM Kolkata Admissions <your_email@gmail.com>"
